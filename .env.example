# AUTH0_DOMAIN is the tenant host only and must not include a scheme (https://).
# AUTH0_SECRET must be exactly 64 hexadecimal characters (openssl rand -hex 32).
# APP_BASE_URL must be a valid URL, for example http://localhost:3000

